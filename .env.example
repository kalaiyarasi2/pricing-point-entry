# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!
# ============================================================================

# OpenAI Configuration
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=120

# Tesseract OCR Configuration (Windows)
# ----------------------------------------------------------------------------
# Uncomment and set if Tesseract is not in your PATH
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler Configuration (Windows)
# ----------------------------------------------------------------------------
# Uncomment and set if Poppler is not in your PATH
# POPPLER_PATH=C:\poppler\Library\bin

# GPU Configuration (Optional)
# ----------------------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0
# GPU_MEMORY_FRACTION=0.8

# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Pipeline Configuration
# ----------------------------------------------------------------------------
# Default working directory for intermediate files
WORK_DIR=pipeline_workspace

# Keep intermediate files after processing
KEEP_INTERMEDIATE_FILES=true

# Default DPI for image rendering
DEFAULT_DPI=300
ROTATION_DPI=200

# ============================================================================
# NOTES
# ============================================================================
#
# 1. OPENAI_API_KEY is required for structured extraction (Stage 4)
# 2. TESSERACT_PATH is only needed on Windows if Tesseract is not in PATH
# 3. POPPLER_PATH is only needed on Windows if Poppler is not in PATH
# 4. GPU settings are only relevant if using rostaing-ocr with CUDA
#
# ============================================================================
